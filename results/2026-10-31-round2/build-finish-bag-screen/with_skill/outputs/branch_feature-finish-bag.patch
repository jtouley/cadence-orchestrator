diff --git a/app/store.py b/app/store.py
index e7c62ba..d340b6c 100644
--- a/app/store.py
+++ b/app/store.py
@@ -443,6 +443,20 @@ class Store:
                     )
         return item
 
+    def finish_bag(self, user_id: str, bag_id: str, on: date) -> bool:
+        """Finish: the bag again with `finished_on` set, as a new record, never an edit or a delete. Finishing a
+        finished bag writes nothing and keeps its first date, so a resend from the outbox is harmless."""
+        prev = self._owned(self.bags, bag_id, user_id)
+        if prev is None or prev.deleted:
+            raise NotFound(bag_id)
+        if prev.item.finished_on:
+            return False
+        # Today in UTC plus a day's grace, as for roast dates, so no zone's "today" is refused.
+        if on > datetime.now(UTC).date() + timedelta(days=1):
+            raise Invalid("That finish date is in the future.")
+        self._commit(self.bags, bag_id, prev.item.model_copy(update={"finished_on": on}), "bags")
+        return True
+
     def save_bag(self, user_id: str, data: dict) -> tuple[Bag, list[dict]]:
         """A bag typed by hand: matched to the catalog the same way a typed shot is."""
         bag = Bag(**{k: v for k, v in data.items() if k != "user_id"}, user_id=user_id)
