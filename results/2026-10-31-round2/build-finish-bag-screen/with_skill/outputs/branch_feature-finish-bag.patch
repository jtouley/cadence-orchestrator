+def test_a_finish_date_must_be_a_real_date_not_in_the_future(client, lake):
+    from datetime import date
+
+    before = len(files(lake, "bags"))
+    future = (date.today() + timedelta(days=5)).isoformat()
+    for body in ({"finished_on": future}, {"finished_on": "soon"}, {"finished_on": 20261031}):
+        assert client.post("/api/bags/bag1/finish", json=body, headers=W).status_code == 422, body
+    assert len(files(lake, "bags")) == before
+    # No date: today's.
+    assert client.post("/api/bags/bag1/finish", headers=W).json()["written"] is True
+    assert client.app.state.store.bag("owner", "bag1").finished_on is not None
