+def test_the_bag_page_has_a_finish_button_that_writes_a_new_record(client, lake):
+    """Finish, like Retract: a new bags record with finished_on; nothing in the lake is edited or deleted."""
+    client.post("/api/shots", json=shot(1), headers=W)
+    page = client.get("/coffee/bag1").text
+    assert 'data-finish="bag1"' in page and ">Finish bag</button>" in page
+    before = {p: p.read_bytes() for p in files(lake, "bags")}
+    shots_before = {p: p.read_bytes() for p in files(lake, "shots")}
+
+    r = client.post("/api/bags/bag1/finish", json={"bag_id": "bag1", "finished_on": "2026-10-30"}, headers=W)
+    assert r.status_code == 200 and r.json() == {"bag_id": "bag1", "written": True}
+    after = files(lake, "bags")
+    assert len(after) == len(before) + 1
+    assert all(p.read_bytes() == b for p, b in before.items())  # the earlier records are untouched
+    assert {p: p.read_bytes() for p in files(lake, "shots")} == shots_before  # shots aren't touched
+    bag = client.app.state.store.bag("owner", "bag1")
+    assert (str(bag.finished_on), bag.coffee_freetext, str(bag.roast_date)) == (
+        "2026-10-30",
+        "Onyx Geometry",
+        "2026-10-18",
+    )
+
+    # Finishing again (a second tap, the outbox resending) writes nothing and keeps the first date.
+    again = client.post("/api/bags/bag1/finish", json={"finished_on": "2026-10-31"}, headers=W)
+    assert again.json() == {"bag_id": "bag1", "written": False}
+    assert len(files(lake, "bags")) == len(before) + 1
+    assert str(client.app.state.store.bag("owner", "bag1").finished_on) == "2026-10-30"
+
+    # The bag page says so and no longer offers Finish; the shots are still there.
+    page = client.get("/coffee/bag1").text
+    assert "finished Oct 30" in page and "data-finish" not in page and "/shot/s1" in page
+
+    # It survives a restart: read back from the lake.
+    store = create_app(lake, HeaderAuth()).state.store
+    assert str(store.bag("owner", "bag1").finished_on) == "2026-10-30"
+    assert store.current_bag("owner") is None
+    assert [s.shot_id for s in store.shots_of("owner")] == ["s1"]
+
+
+def test_a_finished_bag_leaves_today_and_the_pickers_but_stays_in_coffees(client):
+    client.post("/api/shots", json=shot(1, grinder_setting=12), headers=W)
+    client.post("/api/bags", json={"bag_id": "bag2", "coffee_freetext": "Other coffee"}, headers=W)
+    client.post("/api/shots", json=shot(2, bag_id="bag2", grinder_setting=20), headers=W)
+    client.post("/api/bags", json={"bag_id": "bag3", "coffee_freetext": "Third coffee"}, headers=W)
+    client.post("/api/shots", json=shot(3, bag_id="bag3", grinder_setting=30), headers=W)
+    client.get("/bag/bag2/use")  # bag2 is on the grinder
+    assert "Other coffee" in client.get("/").text and prefill(client)["bag_id"] == "bag2"
+
+    assert client.post("/api/bags/bag2/finish", json={}, headers=W).json()["written"] is True
+
+    # Today: as if bag2 had never been picked, the newest open bag, with its own shots.
+    today = client.get("/").text
+    assert "Third coffee" in today and "Other coffee" not in today
+    p = prefill(client)
+    assert (p["bag_id"], p["grinder_setting"]) == ("bag3", 30)
+    # Not in Switch coffee, can't be picked again, and not in the bag picker on Log shot (correcting a shot).
+    switch = client.get("/bags/switch").text
+    assert "bag2" not in switch and "Onyx Geometry" in switch and "Third coffee" in switch
+    assert client.get("/bag/bag2/use").status_code == 404
+    log = client.get("/log?correct=s1").text
+    assert "bag=bag2" not in log and "bag=bag3" in log
+    # Coffees and its own page still have it, marked finished.
+    coffees = client.get("/coffees").text
+    assert "/coffee/bag2" in coffees and re.search(r"Other coffee.*?finished", coffees, re.S)
+    assert "/shot/s2" in client.get("/coffee/bag2").text
+
+    # A shot of the finished bag can still be corrected: its own bag stays listed there, current.
+    assert 'href="/log?correct=s2&amp;bag=bag2" aria-current="true"' in client.get("/log?correct=s2").text
+
+    # With every bag finished, Today has no bag on it: the last shot's coffee, and nothing to switch to.
+    for b in ("bag1", "bag3"):
+        client.post(f"/api/bags/{b}/finish", json={}, headers=W)
+    today = client.get("/").text
+    assert "Last coffee" in today and "On the grinder" not in today and "Switch coffee" not in today
+    assert "Edit bag" not in today
+    assert prefill(client)["bag_id"] is None
+
