+// The bag page's Finish: a second tap, then a new bag record with finished_on (never an edit or a delete), queued
+// like any write. The bag leaves Today and the bag pickers and stays under Coffees.
+function finishBag(b) {
+  const id = b.dataset.finish;
+  const main = document.querySelector("main");
+  b.addEventListener("click", () => confirmTap(b, async () => {
+    b.disabled = true;
+    const now = new Date();
+    const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;
+    try {
+      await send(`finish:${id}`, `/api/bags/${encodeURIComponent(id)}/finish`, { bag_id: id, finished_on: today });
+      go(location.pathname, "Bag finished");
+    } catch (err) {
+      if (err instanceof Rejected) {
+        hint(main, err.message);
+        b.disabled = false;
+        return;
+      }
+      go(location.pathname, "Finished on this phone. It’ll sync when you’re back online.");
+    }
+  }));
+}
+
