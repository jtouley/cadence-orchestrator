diff --git a/app/store.py b/app/store.py
index e7c62ba..939782c 100644
--- a/app/store.py
+++ b/app/store.py
@@ -469,3 +469,16 @@ class Store:
         if not (prev and prev.item == bag):
             self._commit(self.bags, bag.bag_id, bag, "bags")
         return bag, matches
+
+    def finish_bag(self, user_id: str, bag_id: str, on: date) -> bool:
+        """Finish: a new record of the bag with finished_on set, never a delete, like a retraction. It leaves Today
+        and the bag pickers and stays in Coffees. Finishing twice writes once and keeps the first day."""
+        prev = self._owned(self.bags, bag_id, user_id)
+        if prev is None or prev.deleted:
+            raise NotFound(bag_id)
+        if prev.item.finished_on:
+            return False
+        if on > datetime.now(UTC).date() + timedelta(days=1):  # a day's grace, as for the roast date
+            raise Invalid("That day is in the future.")
+        self._commit(self.bags, bag_id, prev.item.model_copy(update={"finished_on": on}), "bags")
+        return True
