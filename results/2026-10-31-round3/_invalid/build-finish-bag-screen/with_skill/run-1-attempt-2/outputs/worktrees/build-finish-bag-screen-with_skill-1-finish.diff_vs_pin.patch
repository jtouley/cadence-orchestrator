+function finishBag(b) {
+  const id = b.dataset.finish;
+  b.addEventListener("click", () => confirmTap(b, async () => {
+    const now = new Date();
+    const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;
+    b.disabled = true;
+    try {
+      await send(`finish:${id}`, `/api/bags/${id}/finish`, { finished_on: today });
+      tick();
+      go(location.pathname, "Bag finished");
+    } catch (err) {
+      if (!(err instanceof Rejected)) return go(location.pathname, "Finished on this phone. It’ll sync when you’re back online.");
+      hint(document.querySelector("main"), err.message);
+      b.disabled = false;
+    }
+  }));
+}
