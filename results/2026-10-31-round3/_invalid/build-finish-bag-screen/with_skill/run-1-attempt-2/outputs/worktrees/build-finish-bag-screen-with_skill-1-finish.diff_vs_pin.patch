+    @app.post("/api/bags/{bag_id}/finish")
+    def finish(bag_id: str, request: Request, me: OutboxWriter, body: dict | None = None) -> dict:
+        """Finish: a new record of the bag, finished (Store.finish_bag), like a retraction. The phone sends its own
+        day, since the request may wait in the outbox; without one, today where the phone is."""
+        raw = (body or {}).get("finished_on")
+        try:
+            on = date.fromisoformat(raw) if raw else datetime.now(tz(request)).date()
+        except (TypeError, ValueError):
+            raise HTTPException(422, "finished_on is a date like 2026-10-31") from None
+        return {"bag_id": bag_id, "written": run(store.finish_bag, me.user_id, bag_id, on)}
+
     return app
 
 
