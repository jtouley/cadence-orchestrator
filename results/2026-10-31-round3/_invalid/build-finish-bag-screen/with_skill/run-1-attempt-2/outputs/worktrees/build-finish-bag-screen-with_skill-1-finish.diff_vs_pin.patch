+def test_finish_writes_a_record_like_a_retraction(client, lake):
+    """Finish is a new record of the bag with finished_on set, never a delete or an overwrite. Finishing twice
+    (the outbox resends) writes once and keeps the first day."""
+    from datetime import date
+
+    before = files(lake, "bags")
+    r = client.post("/api/bags/bag1/finish", json={"finished_on": "2026-10-30"}, headers=W)
+    assert r.json() == {"bag_id": "bag1", "written": True}
+    after = files(lake, "bags")
+    assert len(after) == len(before) + 1 and set(before) <= set(
+        after
+    )  # appended; the old record is still there
+    again = client.post("/api/bags/bag1/finish", json={"finished_on": "2026-10-31"}, headers=W)
+    assert again.json()["written"] is False
+    assert len(files(lake, "bags")) == len(after)
+    bag = client.app.state.store.bag("owner", "bag1")
+    assert bag.finished_on == date(2026, 10, 30)
+    assert (bag.coffee_freetext, str(bag.roast_date)) == ("Onyx Geometry", "2026-10-18")  # the rest is kept
+    # In the lake: the latest record of the bag is the finished one, and a restart reads it back.
+    latest = {r["bag_id"]: r for r in lake.latest("bags", "bag_id")}["bag1"]
+    assert str(latest["finished_on"]) == "2026-10-30" and not latest["deleted"]
+    assert create_app(lake, HeaderAuth()).state.store.bag("owner", "bag1").finished_on == date(2026, 10, 30)
+
+
+def test_finish_defaults_to_the_phones_day_and_refuses_what_it_cant_apply(client, lake):
+    from datetime import date
+    from zoneinfo import ZoneInfo
+
+    client.post("/api/bags", json={"bag_id": "bag2", "coffee_freetext": "Other coffee"}, headers=W)
+    client.cookies.set("tz", "Pacific/Kiritimati")  # UTC+14: often a day ahead of the server
+    assert client.post("/api/bags/bag2/finish", headers=W).json()["written"] is True
+    assert (
+        client.app.state.store.bag("owner", "bag2").finished_on
+        == datetime.now(ZoneInfo("Pacific/Kiritimati")).date()
+    )
+    n = len(files(lake, "bags"))
+    assert client.post("/api/bags/bag1/finish", json={}).status_code == 403  # writes need the header
+    assert client.post("/api/bags/nope/finish", json={}, headers=W).status_code == 404
+    bob = W | {"x-test-user": "bob", "X-Expected-User": "bob"}
+    assert client.post("/api/bags/bag1/finish", json={}, headers=bob).status_code == 404  # someone else's bag
+    assert client.post("/api/bags/bag1/finish", json={"finished_on": "soon"}, headers=W).status_code == 422
+    future = (date.today() + timedelta(days=5)).isoformat()
+    assert client.post("/api/bags/bag1/finish", json={"finished_on": future}, headers=W).status_code == 422
+    assert len(files(lake, "bags")) == n
+    assert client.app.state.store.bag("owner", "bag1").finished_on is None
+
+
+def test_a_finished_bag_leaves_today_and_the_bag_pickers_but_stays_in_coffees(client):
+    client.post("/api/shots", json=shot(1), headers=W)
+    client.post("/api/bags", json={"bag_id": "bag2", "coffee_freetext": "Other coffee"}, headers=W)
+    client.post("/api/shots", json=shot(2, bag_id="bag2"), headers=W)
+    client.get("/bag/bag1/use")  # bag1 is the one on the grinder
+    assert "Onyx Geometry" in client.get("/").text and prefill(client)["bag_id"] == "bag1"
+    page = client.get("/coffee/bag1").text
+    assert 'data-finish="bag1"' in page and ">Finish bag</button>" in page
+
+    assert client.post("/api/bags/bag1/finish", json={"finished_on": "2026-10-30"}, headers=W).json()[
+        "written"
+    ]
+
+    # Today: the open bag takes its place, even with the finished one still selected; nothing to switch to.
+    today = client.get("/").text
+    assert "Other coffee" in today and "Onyx Geometry" not in today
+    assert "/coffee/bag2" in today and "/bag/bag1/edit" not in today and "Switch coffee" not in today
+    # The bag pickers: Switch coffee, selecting it, Log shot, and the bags offered when correcting a shot.
+    switch = client.get("/bags/switch").text
+    assert "Other coffee" in switch and "Onyx Geometry" not in switch and "/bag/bag1/use" not in switch
+    assert client.get("/bag/bag1/use").status_code == 404
+    assert prefill(client)["bag_id"] == "bag2"
+    assert client.get("/log?bag=bag1").status_code == 200 and prefill(client)["bag_id"] == "bag2"
+    client.post("/api/bags", json={"bag_id": "bag3", "coffee_freetext": "Third coffee"}, headers=W)
+    correcting = client.get("/log?correct=s2").text
+    assert "bag=bag3" in correcting and "bag=bag1" not in correcting
