+def two_open_bags(c: TestClient) -> None:
+    """bag1 (Onyx Geometry, the fixture's) and bag2 (Other coffee, picked), a shot on each."""
+    c.post("/api/shots", json=shot(1), headers=W)
+    c.post("/api/bags", json={"bag_id": "bag2", "coffee_freetext": "Other coffee"}, headers=W)
+    c.post("/api/shots", json=shot(2, bag_id="bag2"), headers=W)
+    c.get("/bag/bag2/use")
+
+
+def finish(c: TestClient, bag_id: str = "bag2", on: str | None = "2026-10-30", **kw):
+    return c.post(f"/api/bags/{bag_id}/finish", json={"finished_on": on} if on else {}, headers=W, **kw)
+
+
+def test_the_bag_page_has_a_finish_button_until_the_bag_is_finished(client):
+    two_open_bags(client)
+    page = client.get("/coffee/bag2").text
+    assert 'data-finish-bag="bag2"' in page and "Finish this bag" in page
+    assert finish(client).json() == {"bag_id": "bag2", "written": True}
+    page = client.get("/coffee/bag2").text
+    assert "data-finish-bag" not in page and "Finished Oct 30" in page
+    assert 'data-finish-bag="bag1"' in client.get("/coffee/bag1").text  # the other bag is still open
+
+
+def test_finishing_writes_a_new_record_and_deletes_nothing(client, lake):
+    two_open_bags(client)
+    before = set(files(lake, "bags"))
+    assert finish(client).json()["written"] is True
+    after = set(files(lake, "bags"))
+    assert before < after and len(after - before) == 1  # one new file; every earlier one still there
+    import pyarrow.parquet as pq
+
+    (new,) = after - before
+    row = pq.read_table(new).to_pylist()[0]
+    assert row["bag_id"] == "bag2" and str(row["finished_on"]) == "2026-10-30" and row["deleted"] is False
+    assert row["coffee_freetext"] == "Other coffee"  # the rest of the bag as it was
+    # The outbox resends: nothing more is written, and the first finish date stands.
+    assert finish(client, on="2026-10-31").json()["written"] is False
+    assert set(files(lake, "bags")) == after
+    # Read back from the lake, the bag is finished.
+    fresh = TestClient(create_app(lake, HeaderAuth()))
+    assert str(fresh.app.state.store.bag("owner", "bag2").finished_on) == "2026-10-30"
+
+
+def test_a_finished_bag_leaves_today_and_the_log_shot_bag_picker(client):
+    two_open_bags(client)
+    today = client.get("/").text
+    assert "Other coffee" in today and "Switch coffee" in today
+    assert "Other coffee" in client.get("/bags/switch").text
+    log = client.get("/log?correct=s1").text
+    assert 'href="/log?correct=s1&amp;bag=bag2"' in log
+
+    finish(client)
+    # Today falls back to the open bag, even though the finished one is still the picked one.
+    today = client.get("/").text
+    assert "Onyx Geometry" in today and "Other coffee" not in today and "Switch coffee" not in today
+    assert "Other coffee" not in client.get("/bags/switch").text
+    assert prefill(client)["bag_id"] == "bag1"
+    assert "Other coffee" not in client.get("/log").text
+    # Correcting a shot of the open bag no longer offers the finished one.
+    log = client.get("/log?correct=s1").text
+    assert "bag=bag2" not in log and "Other coffee" not in log
+    assert client.get("/bag/bag2/use").status_code == 404
+
+
+def test_a_finished_bag_still_shows_in_coffees(client):
+    two_open_bags(client)
+    finish(client)
+    coffees = client.get("/coffees").text
+    assert 'href="/coffee/bag2"' in coffees and "Other coffee" in coffees and " · finished" in coffees
+    assert 'href="/coffee/bag1"' in coffees
+    assert client.get("/coffee/bag2").status_code == 200
+
+
+def test_finish_refuses_someone_elses_bag_a_missing_one_and_a_bad_date(client, lake):
+    two_open_bags(client)
+    before = set(files(lake, "bags"))
+    maya = W | {"x-test-user": "maya", "X-Expected-User": "maya"}
+    assert client.post("/api/bags/bag2/finish", json={}, headers=maya).status_code == 404
+    assert finish(client, "nope").status_code == 404
+    assert finish(client, on="yesterday").status_code == 422
+    future = (datetime.now(UTC).date() + timedelta(days=3)).isoformat()
+    assert finish(client, on=future).status_code == 422
+    # Queued under another account (signed out, someone else signed in): held, not written.
+    assert (
+        client.post("/api/bags/bag2/finish", json={}, headers=W | {"X-Expected-User": "maya"}).status_code
+        == 403
+    )
+    assert set(files(lake, "bags")) == before
+    assert client.app.state.store.bag("owner", "bag2").finished_on is None
+
+
+def test_finish_without_a_date_uses_today_in_the_phones_zone(client):
+    two_open_bags(client)
+    client.cookies.set("tz", "Pacific%2FKiritimati")  # UTC+14: often a day ahead of UTC
+    assert finish(client, on=None).status_code == 200
+    from zoneinfo import ZoneInfo
+
+    expected = datetime.now(ZoneInfo("Pacific/Kiritimati")).date()
+    assert client.app.state.store.bag("owner", "bag2").finished_on == expected
+
+
