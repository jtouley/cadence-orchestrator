+// A bag's Finish: a new bags record with finished_on set (never a delete), queued like any write. The phone's date
+// goes with it, so a finish that syncs tomorrow still says the day it was tapped. Edit bag can set it back.
+function finishBag(b) {
+  const box = b.closest("[data-finish]");
+  b.addEventListener("click", async () => {
+    b.disabled = true;
+    const now = new Date();
+    const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;
+    const id = b.dataset.finishBag;
+    try {
+      await send(`finish:${id}`, `/api/bags/${encodeURIComponent(id)}/finish`, { finished_on: today });
+      tick(8);
+      go(location.pathname, `Bag finished: ${b.dataset.name}`);
+    } catch (err) {
+      if (!(err instanceof Rejected)) return go(location.pathname, `Finished on this phone: ${b.dataset.name}. It’ll sync when you’re back online.`);
+      hint(box, err.message);
+      b.disabled = false;
+    }
+  });
+}
+
