diff --git a/app/store.py b/app/store.py
index e7c62ba..5dc2a1d 100644
--- a/app/store.py
+++ b/app/store.py
@@ -469,3 +469,18 @@ class Store:
         if not (prev and prev.item == bag):
             self._commit(self.bags, bag.bag_id, bag, "bags")
         return bag, matches
+
+    def finish_bag(self, user_id: str, bag_id: str, on: date | None = None) -> bool:
+        """Finish: the bag again with `finished_on` set, as a new record (like a retraction), never a delete or an
+        edit of the old one. Its shots stay with it. Finishing a finished bag writes nothing and keeps its date."""
+        prev = self._owned(self.bags, bag_id, user_id)
+        if prev is None or prev.deleted:
+            raise NotFound(bag_id)
+        if prev.item.finished_on:
+            return False
+        on = on or date.today()
+        # The roast date's rule: past tomorrow in UTC, so no zone's today is refused.
+        if on > datetime.now(UTC).date() + timedelta(days=1):
+            raise Invalid("That date is in the future.")
+        self._commit(self.bags, bag_id, prev.item.model_copy(update={"finished_on": on}), "bags")
+        return True
