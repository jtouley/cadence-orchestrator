@@ -469,3 +469,22 @@ class Store:
         if not (prev and prev.item == bag):
             self._commit(self.bags, bag.bag_id, bag, "bags")
         return bag, matches
+
+    def finish_bag(self, user_id: str, bag_id: str, on: date) -> bool:
+        """Finish: the bag again with `finished_on` set, as a new record under the same id (latest wins), never a
+        delete. It leaves Today and the bag pickers and stays in Coffees. Finishing a finished bag writes nothing."""
+        prev = self._owned(self.bags, bag_id, user_id)
+        if prev is None or prev.deleted:
+            raise NotFound(bag_id)
+        if prev.item.finished_on:
+            return False
+        if on > datetime.now(UTC).date() + timedelta(days=1):  # the same day's grace as a roast date
+            raise Invalid("That date is in the future. Check the phone's clock.")
+        bag = prev.item
+        # opened_on is the server's day and the date is the phone's, which can be a day behind: a day's grace.
+        if (bag.roast_date and on < bag.roast_date) or (
+            bag.opened_on and on < bag.opened_on - timedelta(days=1)
+        ):
+            raise Invalid("That date is before the bag was roasted or opened. Check the phone's clock.")
+        self._commit(self.bags, bag_id, bag.model_copy(update={"finished_on": on}), "bags")
+        return True
