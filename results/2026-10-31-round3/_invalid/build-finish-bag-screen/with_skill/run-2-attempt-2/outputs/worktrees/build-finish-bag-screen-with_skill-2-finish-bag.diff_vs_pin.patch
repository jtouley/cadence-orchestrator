diff --git a/tests/test_finish_bag.py b/tests/test_finish_bag.py
new file mode 100644
index 0000000..bd97069
--- /dev/null
+++ b/tests/test_finish_bag.py
@@ -0,0 +1,163 @@
+"""Finish bag: the button on the bag's page writes a new record with finished_on (like a retraction, never a
+delete); the bag leaves Today and the bag pickers on Today and Log shot, and stays in Coffees."""
+
+from datetime import date, datetime, timedelta
+from zoneinfo import ZoneInfo
+
+import pyarrow.parquet as pq
+import pytest
+from fastapi.testclient import TestClient
+
+from app.main import create_app
+
+from .test_app import HeaderAuth, W, files, prefill, setup, shot
+
+FINISH = {"finished_on": "2026-10-30"}
+
+
+@pytest.fixture
+def client(lake):
+    """Equipment and one open bag, bag1 (Onyx Geometry, roasted Oct 18), as in test_app."""
+    c = TestClient(create_app(lake, HeaderAuth()))
+    setup(c)
+    body = {"bag_id": "bag1", "coffee_freetext": "Onyx Geometry", "roast_date": "2026-10-18"}
+    assert c.post("/api/bags", json=body, headers=W).status_code == 200
+    return c
+
+
+def snapshot(lake, table: str) -> dict:
+    """Every file of a table and its bytes, to show nothing already written was changed or removed."""
+    return {p.name: p.read_bytes() for p in files(lake, table)}
+
+
+def test_the_bag_page_has_a_finish_button_until_the_bag_is_finished(client):
+    page = client.get("/coffee/bag1").text
+    assert 'data-finish-bag="bag1"' in page and ">Finish bag</button>" in page
+    assert client.post("/api/bags/bag1/finish", json=FINISH, headers=W).status_code == 200
+    r = client.get("/coffee/bag1")
+    page = r.text
+    assert r.status_code == 200 and "data-finish-bag" not in page
+    assert "Roasted Oct 18 · day 12 · finished Oct 30" in page
+
+
+def test_finishing_appends_one_record_and_deletes_nothing(client, lake):
+    client.post("/api/shots", json=shot(1), headers=W)
+    bags_before, shots_before = snapshot(lake, "bags"), snapshot(lake, "shots")
+    r = client.post("/api/bags/bag1/finish", json=FINISH, headers=W)
+    assert r.json() == {"bag_id": "bag1", "written": True}
+    bags_after = snapshot(lake, "bags")
+    assert {k: v for k, v in bags_after.items() if k in bags_before} == bags_before  # untouched
+    new = [lake.root / "bags" / name for name in bags_after.keys() - bags_before.keys()]
+    assert len(new) == 1
+    (row,) = pq.read_table(new[0]).to_pylist()
+    assert row["bag_id"] == "bag1" and row["finished_on"] == date(2026, 10, 30) and row["deleted"] is False
+    assert (row["coffee_freetext"], row["roast_date"]) == (
+        "Onyx Geometry",
+        date(2026, 10, 18),
+    )  # the rest kept
+    assert snapshot(lake, "shots") == shots_before  # its shots stay as they were
+
+    # Finishing again (the outbox resending, a second tap) writes nothing.
+    assert client.post("/api/bags/bag1/finish", json=FINISH, headers=W).json()["written"] is False
+    assert len(files(lake, "bags")) == len(bags_after)
+
+    # A restart reads it back from the lake: still finished, nothing on the grinder.
+    store = create_app(lake, HeaderAuth()).state.store
+    assert store.bag("owner", "bag1").finished_on == date(2026, 10, 30)
+    assert store.current_bag("owner") is None
+
+
+def test_a_finished_bag_leaves_today(client):
+    client.post("/api/shots", json=shot(1), headers=W)
+    client.post("/api/bags", json={"bag_id": "bag2", "coffee_freetext": "Other coffee"}, headers=W)
+    client.get("/bag/bag2/use")
+    today = client.get("/").text
+    assert "Other coffee" in today and "Switch coffee" in today
+
+    client.post("/api/bags/bag2/finish", json=FINISH, headers=W)
+    today = client.get("/").text  # the cookie still names bag2
+    assert "Other coffee" not in today and "/bag/bag2/edit" not in today
+    assert 'href="/coffee/bag1">Onyx Geometry</a>' in today  # the open bag is on the grinder again
+    assert "Switch coffee" not in today  # one open bag left: nothing to switch to
+
+    # The last open bag finished: Today no longer offers it as the bag on the grinder.
+    client.post("/api/bags/bag1/finish", json=FINISH, headers=W)
+    today = client.get("/").text
+    assert "On the grinder" not in today and 'href="/coffee/bag1"' not in today and "Edit bag" not in today
+    assert prefill(client)["bag_id"] is None  # Log shot doesn't put a new shot in it
+
+
+def test_a_finished_bag_leaves_the_bag_pickers(client):
+    client.post("/api/bags", json={"bag_id": "bag2", "coffee_freetext": "Other coffee"}, headers=W)
+    client.post("/api/bags", json={"bag_id": "bag3", "coffee_freetext": "Third coffee"}, headers=W)
+    client.post("/api/shots", json=shot(1, bag_id="bag3"), headers=W)
+    assert 'href="/bag/bag2/use"' in client.get("/bags/switch").text
+    assert 'href="/log?correct=s1&amp;bag=bag2"' in client.get("/log?correct=s1").text
+
+    client.post("/api/bags/bag2/finish", json=FINISH, headers=W)
+    switch = client.get("/bags/switch").text
+    assert "/bag/bag2/use" not in switch and "Other coffee" not in switch
+    assert 'href="/bag/bag1/use"' in switch and 'href="/bag/bag3/use"' in switch
+    log = client.get("/log?correct=s1").text  # the bag list on Log shot when correcting a shot
+    assert "bag=bag2" not in log and 'href="/log?correct=s1&amp;bag=bag1"' in log
+    assert client.get("/bag/bag2/use").status_code == 404  # nor can it be picked by its link
+
+
+def test_a_finished_bag_still_shows_in_coffees(client):
+    client.post("/api/shots", json=shot(1), headers=W)
+    client.post("/api/bags/bag1/finish", json=FINISH, headers=W)
+    coffees = client.get("/coffees").text
+    assert 'href="/coffee/bag1"' in coffees and "Onyx Geometry" in coffees
+    assert "1 shot · best rated 4, Oct 21 · finished" in coffees
+    assert "Onyx Geometry" in client.get("/history").text
+    assert client.get("/shot/s1").status_code == 200
+
+
+def test_finish_is_refused_for_someone_elses_or_a_missing_bag_and_a_bad_date(client, lake):
+    maya = W | {"x-test-user": "maya", "X-Expected-User": "maya"}
+    before = len(files(lake, "bags"))
+    assert client.post("/api/bags/bag1/finish", json=FINISH, headers=maya).status_code == 404
+    assert client.post("/api/bags/nope/finish", json=FINISH, headers=W).status_code == 404
+    future = (date.today() + timedelta(days=5)).isoformat()
+    assert client.post("/api/bags/bag1/finish", json={"finished_on": future}, headers=W).status_code == 422
+    assert client.post("/api/bags/bag1/finish", json={"finished_on": "soon"}, headers=W).status_code == 422
+    assert (
+        client.post("/api/bags/bag1/finish", json=FINISH).status_code == 403
+    )  # a write needs the app's header
+    assert len(files(lake, "bags")) == before
+    assert client.app.state.store.bag("owner", "bag1").finished_on is None
+
+
+def test_finish_without_a_date_uses_today_in_the_viewers_zone(client):
+    """Not the server's date: UTC+14 and UTC-11 are 25 hours apart, so one of them is on another day than it."""
+    zone = next(
+        z
+        for z in ("Pacific/Kiritimati", "Pacific/Pago_Pago")
+        if datetime.now(ZoneInfo(z)).date() != date.today()
+    )
+    client.cookies.set("tz", zone)
+    assert client.post("/api/bags/bag1/finish", json={}, headers=W).json()["written"] is True
+    assert client.app.state.store.bag("owner", "bag1").finished_on == datetime.now(ZoneInfo(zone)).date()
+
+
+def test_finish_is_refused_before_the_bag_was_roasted_or_opened(client, lake):
+    before = len(files(lake, "bags"))
+    early = {"finished_on": "2026-10-17"}  # the day before its roast date
+    r = client.post("/api/bags/bag1/finish", json=early, headers=W)
+    assert r.status_code == 422 and "before" in r.json()["detail"]
+    # Opened on the server's day; a phone a zone behind may still be on the day before, so that day is accepted.
+    store = client.app.state.store
+    opened = store.bag("owner", "bag1").opened_on
+    too_early = {"finished_on": (opened - timedelta(days=2)).isoformat()}
+    client.post("/api/bags", json={"bag_id": "bag2", "coffee_freetext": "No roast date"}, headers=W)
+    assert client.post("/api/bags/bag2/finish", json=too_early, headers=W).status_code == 422
+    assert len(files(lake, "bags")) == before + 1  # only bag2's own record
+    day_before = {"finished_on": (opened - timedelta(days=1)).isoformat()}
+    assert client.post("/api/bags/bag2/finish", json=day_before, headers=W).json()["written"] is True
+
+
+@pytest.mark.parametrize("value", [20261030, 1, True, ["2026-10-30"], "20261030", "2026-10-30T08:00"])
+def test_finish_takes_only_a_yyyy_mm_dd_date(client, value):
+    r = client.post("/api/bags/bag1/finish", json={"finished_on": value}, headers=W)
+    assert r.status_code == 422
+    assert client.app.state.store.bag("owner", "bag1").finished_on is None
