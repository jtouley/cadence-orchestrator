+// Finish a bag: the bag again as a new record with finished_on set, never a delete (like a retraction). It leaves
+// Today and the bag pickers and stays under Coffees; Edit bag ("Still using it") takes it back. The day is the
+// phone's own today, as Edit bag sends it.
+function finishBag(b) {
+  b.addEventListener("click", async () => {
+    const id = b.dataset.finish;
+    const now = new Date();
+    const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;
+    b.disabled = true;
+    hint(document.querySelector("main"), "");
+    try {
+      await send(`finish:${id}`, `/api/bags/${id}/finish`, { bag_id: id, finished_on: today });
+      go(location.pathname, `Bag finished: ${b.dataset.name}`);
+    } catch (err) {
+      if (err instanceof Rejected) {
+        hint(document.querySelector("main"), err.message);
+        b.disabled = false;
+        return;
+      }
+      go(location.pathname, `Bag finished on this phone: ${b.dataset.name}. It’ll sync when you’re back online.`);
+    }
+  });
+}
+
