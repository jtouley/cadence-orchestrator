         self._commit(self.shots, shot_id, prev.item, "shots")
         return True
 
+    def finish_bag(self, user_id: str, bag_id: str, on: date | None = None) -> tuple[Bag, bool]:
+        """Finish: the bag again as a new record with `finished_on` set, never a delete or a rewrite. Its shots stay
+        with it. Finishing a finished bag writes nothing (an outbox resend), and keeps the day it was finished."""
+        prev = self._owned(self.bags, bag_id, user_id)
+        if prev is None or prev.deleted:
+            raise NotFound(bag_id)
+        if prev.item.finished_on:
+            return prev.item, False
+        on = on or date.today()
+        # Like the roast date: today in UTC plus a day's grace, so the phone's own "today" is never refused.
+        if on > datetime.now(UTC).date() + timedelta(days=1):
+            raise Invalid("That day is in the future. Check the phone's date.")
+        bag = prev.item.model_copy(update={"finished_on": on})
+        self._commit(self.bags, bag_id, bag, "bags")
+        return bag, True
+
