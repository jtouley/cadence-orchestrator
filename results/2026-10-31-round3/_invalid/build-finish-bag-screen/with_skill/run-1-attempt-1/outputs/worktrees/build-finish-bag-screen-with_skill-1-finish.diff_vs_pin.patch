+
+
+# --- Finish (the button on the bag page) ---------------------------------------------------------------
+
+
+def lake_files(lake: Lake) -> dict[str, bytes]:
+    return {str(p.relative_to(lake.root)): p.read_bytes() for p in lake.root.rglob("*") if p.is_file()}
+
+
+def test_finish_on_the_bag_page_appends_a_record_and_deletes_nothing(client, lake):
+    client.post("/api/shots", json=shot(1), headers=W)
+    page = client.get("/coffee/bag1").text
+    assert 'data-finish="bag1"' in page and ">Finish bag</button>" in page
+    before = lake_files(lake)
+    r = client.post("/api/bags/bag1/finish", json={"bag_id": "bag1", "finished_on": "2026-10-30"}, headers=W)
+    assert r.status_code == 200
+    assert r.json() == {"bag_id": "bag1", "finished_on": "2026-10-30", "written": True}
+    after = lake_files(lake)
+    # Every file that was there is still there, byte for byte: one new bags file, nothing deleted or rewritten.
+    assert {k: after.get(k) for k in before} == before
+    new = [k for k in after if k not in before]
+    assert len(new) == 1 and new[0].startswith("bags/bag1__")
+    # The new record is the whole bag again with finished_on set; the shot is untouched.
+    store = create_app(lake, HeaderAuth()).state.store  # a restart reads it back from the lake
+    bag = store.bag("owner", "bag1")
+    assert (str(bag.finished_on), bag.coffee_freetext, str(bag.roast_date)) == (
+        "2026-10-30",
+        "Onyx Geometry",
+        "2026-10-18",
+    )
+    assert [s.bag_id for s in store.shots_of("owner")] == ["bag1"]
+    # The outbox resends it: nothing more is written, and the day it was finished stays.
+    again = client.post("/api/bags/bag1/finish", json={"finished_on": "2026-10-31"}, headers=W)
+    assert again.json() == {"bag_id": "bag1", "finished_on": "2026-10-30", "written": False}
+    assert lake_files(lake) == after
+    # The page says it's finished and no longer offers the button.
+    page = client.get("/coffee/bag1").text
+    assert "finished Oct 30" in page and "data-finish" not in page
+
+
+def test_finish_without_a_day_uses_today(client):
+    r = client.post("/api/bags/bag1/finish", headers=W)
+    assert r.status_code == 200 and r.json()["written"] is True
+    assert client.app.state.store.bag("owner", "bag1").finished_on is not None
+
+
+def test_a_finished_bag_leaves_today_and_log_shot_but_stays_in_coffees(client):
+    client.post("/api/shots", json=shot(1), headers=W)
+    client.post("/api/bags", json={"bag_id": "bag2", "coffee_freetext": "Other coffee"}, headers=W)
+    client.post("/api/shots", json=shot(2, bag_id="bag2"), headers=W)
+    client.get("/bag/bag2/use")  # on the grinder
+    assert "Other coffee" in client.get("/").text and "Switch coffee" in client.get("/").text
+    assert 'href="/log?correct=s1&amp;bag=bag2"' in client.get("/log?correct=s1").text
+
+    assert client.post("/api/bags/bag2/finish", json={"finished_on": "2026-10-30"}, headers=W).json()[
+        "written"
+    ]
+
+    # Today: the other open bag, and no switching to the finished one.
+    today = client.get("/").text
+    assert "Onyx Geometry" in today and "Other coffee" not in today and "Switch coffee" not in today
+    assert "Other coffee" not in client.get("/bags/switch").text
+    assert client.get("/bag/bag2/use").status_code == 404
+    # Log shot: starts on the open bag, and the bag picker (correcting a shot) no longer offers it.
+    p = prefill(client)
+    assert p["bag_id"] == "bag1" and p["coffee_freetext"] == "Onyx Geometry"
+    assert "bag=bag2" not in client.get("/log?correct=s1").text
+    # Coffees: still there, with its shot.
+    coffees = client.get("/coffees").text
+    assert "Other coffee" in coffees and "/coffee/bag2" in coffees
+    page = client.get("/coffee/bag2").text
+    assert "Other coffee" in page and "/shot/s2" in page and "finished Oct 30" not in page  # no roast date
+    assert "Finished Oct 30" in page
+
+
+def test_finishing_the_last_open_bag_leaves_today_with_no_bag_on_the_grinder(client):
+    client.post("/api/shots", json=shot(1), headers=W)
