diff --git a/app/store.py b/app/store.py
index e7c62ba..5a77405 100644
--- a/app/store.py
+++ b/app/store.py
@@ -469,3 +469,17 @@ class Store:
         if not (prev and prev.item == bag):
             self._commit(self.bags, bag.bag_id, bag, "bags")
         return bag, matches
+
+    def finish_bag(self, user_id: str, bag_id: str, on: date) -> bool:
+        """Finish: the bag again with finished_on set, as a new record (like a retraction), never an edit or a
+        delete. Finishing a finished bag writes nothing and keeps its first date, so a resend changes nothing."""
+        prev = self._owned(self.bags, bag_id, user_id)
+        if prev is None or prev.deleted:
+            raise NotFound(bag_id)
+        if prev.item.finished_on:
+            return False
+        # The phone's date, with the same day's grace as a roast date, so no zone's "today" is refused.
+        if on > datetime.now(UTC).date() + timedelta(days=1):
+            raise Invalid("That date is in the future. Check the phone’s date.")
+        self._commit(self.bags, bag_id, prev.item.model_copy(update={"finished_on": on}), "bags")
+        return True
