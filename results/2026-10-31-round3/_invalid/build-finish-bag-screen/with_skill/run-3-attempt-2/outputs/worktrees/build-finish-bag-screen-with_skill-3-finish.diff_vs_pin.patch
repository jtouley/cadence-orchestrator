+def test_finish_on_the_bag_page_writes_a_new_record_and_keeps_the_old_one(client, lake):
+    """Finish, like a retraction: one new bag record with finished_on set; nothing is deleted or rewritten."""
+    import pyarrow.parquet as pq
+
+    page = client.get("/coffee/bag1").text
+    assert 'data-finish="bag1"' in page and ">Finish bag</button>" in page
+    before = sorted(files(lake, "bags"))
+    r = client.post("/api/bags/bag1/finish", json={"bag_id": "bag1", "finished_on": "2026-10-30"}, headers=W)
+    assert r.status_code == 200 and r.json() == {"bag_id": "bag1", "written": True}
+    after = sorted(files(lake, "bags"))
+    # Appended: the old files are all still there.
+    assert len(after) == len(before) + 1 and set(before) <= set(after)
+    new = pq.read_table(next(iter(set(after) - set(before)))).to_pylist()
+    assert len(new) == 1 and str(new[0]["finished_on"]) == "2026-10-30" and not new[0]["deleted"]
+    assert new[0]["coffee_freetext"] == "Onyx Geometry" and str(new[0]["roast_date"]) == "2026-10-18"
+    assert all(row["finished_on"] is None for p in before for row in pq.read_table(p).to_pylist())
+    # The outbox resending it, or a second tap on a stale page, writes nothing and keeps the first date.
+    again = client.post("/api/bags/bag1/finish", json={"finished_on": "2026-10-31"}, headers=W)
+    assert again.status_code == 200 and again.json()["written"] is False
+    assert len(files(lake, "bags")) == len(after)
+    assert str(client.app.state.store.bag("owner", "bag1").finished_on) == "2026-10-30"
+    # The bag page says it's finished and no longer offers Finish; a restart reads it back the same way.
+    page = client.get("/coffee/bag1").text
+    assert "finished Oct 30" in page and "data-finish" not in page
+    restarted = create_app(lake, HeaderAuth()).state.store
+    assert str(restarted.bag("owner", "bag1").finished_on) == "2026-10-30"
+
+
+def test_a_finished_bag_leaves_today_and_the_pickers_but_stays_in_coffees(client):
+    client.post("/api/shots", json=shot(1), headers=W)
+    client.post("/api/bags", json={"bag_id": "bag2", "coffee_freetext": "Other coffee"}, headers=W)
+    client.post("/api/shots", json=shot(2, bag_id="bag2", coffee_freetext="Other coffee"), headers=W)
+    client.post("/api/bags", json={"bag_id": "bag3", "coffee_freetext": "Third coffee"}, headers=W)
+    client.get("/bag/bag2/use")  # selected on this phone: finishing it must not leave it on Today
+    assert "Other coffee" in client.get("/").text and prefill(client)["bag_id"] == "bag2"
+
+    r = client.post("/api/bags/bag2/finish", json={"finished_on": "2026-10-30"}, headers=W)
+    assert r.json()["written"]
+    today = client.get("/").text
+    assert "Other coffee" not in today and 'href="/bag/bag2/edit' not in today
+    assert prefill(client)["bag_id"] == "bag3"
+    # Not in Switch coffee, can't be chosen, and not offered when moving another bag's shot on Log shot.
+    switch = client.get("/bags/switch").text
+    assert "Onyx Geometry" in switch and "Third coffee" in switch and "Other coffee" not in switch
+    assert client.get("/bag/bag2/use").status_code == 404
+    log = client.get("/log?correct=s1").text
+    assert "bag=bag3" in log and "bag=bag2" not in log
+    # Still in Coffees, marked finished, and its page still opens with its shots.
+    coffees = client.get("/coffees").text
+    assert 'href="/coffee/bag2"' in coffees and "Other coffee" in coffees and "· finished" in coffees
+    assert "finished Oct 30" not in client.get("/coffee/bag1").text
+    assert "/shot/s2" in client.get("/coffee/bag2").text
+
+
+def test_finishing_the_only_open_bag_takes_it_off_the_grinder(client):
+    client.post("/api/shots", json=shot(1), headers=W)
