+// A bag's Finish: a new record with today's date on the phone (never a delete or an edit), queued like any write.
+// The bag then leaves Today and Switch coffee, and stays in Coffees; Edit bag's "Still using it" undoes it.
+function finishBag(b) {
+  b.addEventListener("click", async () => {
+    const id = b.dataset.finish;
+    const now = new Date();
+    const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;
+    b.disabled = true;
+    const here = location.pathname + location.search;
+    try {
+      await send(`finish:${id}`, `/api/bags/${encodeURIComponent(id)}/finish`, { bag_id: id, finished_on: today });
+      go(here, `Bag finished: ${b.dataset.name}`);
+    } catch (err) {
+      if (!(err instanceof Rejected)) return go(here, `Bag finished on this phone: ${b.dataset.name}. It’ll sync when you’re back online.`);
+      hint(document.querySelector("main"), err.message);
+      b.disabled = false;
+    }
+  });
+}
