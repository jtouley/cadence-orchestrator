diff --git a/app/store.py b/app/store.py
index e7c62ba..8108ace 100644
--- a/app/store.py
+++ b/app/store.py
@@ -469,3 +469,20 @@ class Store:
         if not (prev and prev.item == bag):
             self._commit(self.bags, bag.bag_id, bag, "bags")
         return bag, matches
+
+    def finish_bag(self, user_id: str, bag_id: str, on: date) -> bool:
+        """Finish: the bag again with `finished_on` set, as a new record, never a delete. It leaves Today and the
+        bag pickers and stays in Coffees with its shots. Finishing a finished bag writes nothing and keeps its date,
+        so a resend from the outbox is harmless. Edit bag ("Still using it") opens it again."""
+        prev = self._owned(self.bags, bag_id, user_id)
+        if prev is None or prev.deleted:
+            raise NotFound(bag_id)
+        if prev.item.finished_on:
+            return False
+        # The phone's own date, with the same day's grace as a roast date, so no zone's "today" is refused.
+        if on > datetime.now(UTC).date() + timedelta(days=1):
+            raise Invalid("That finish date is in the future. Check the phone’s date.")
+        if prev.item.opened_on and on < prev.item.opened_on:
+            on = prev.item.opened_on  # a phone clock behind the server's: not finished before it was opened
+        self._commit(self.bags, bag_id, prev.item.model_copy(update={"finished_on": on}), "bags")
+        return True
