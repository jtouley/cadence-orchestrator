+// A bag's Finish: a second tap, then a record of the bag with finished_on set (never a delete), queued like any
+// write. The phone's date goes with it, so a finish that waits offline keeps the day it was tapped. Edit bag
+// ("Still using it") opens it again.
+function finishBag(b) {
+  b.addEventListener("click", () => confirmTap(b, async () => {
+    const id = b.dataset.finish;
+    const now = new Date();
+    const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;
+    b.disabled = true;
+    try {
+      await send(`finish:${id}`, `/api/bags/${id}/finish`, { bag_id: id, finished_on: today });
+      tick(8);
+      go(location.pathname, `Bag finished: ${b.dataset.name}`);
+    } catch (err) {
+      if (!(err instanceof Rejected)) return go(location.pathname, `Finished on this phone: ${b.dataset.name}. It’ll sync when you’re back online.`);
+      hint(document.querySelector("main"), err.message);
+      b.disabled = false;
+    }
+  }));
+}
