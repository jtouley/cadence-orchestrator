+
+
+# --- finishing a bag -----------------------------------------------------------------------------------
+
+# Bags in these tests are opened today (the server's date), and a finish is never dated before that.
+TODAY = date.today().isoformat()
+LATER = (datetime.now(UTC).date() + timedelta(days=1)).isoformat()  # the furthest ahead a phone may be
+
+
+def test_finish_writes_a_record_never_a_delete_and_once(client, lake):
+    client.post("/api/shots", json=shot(1), headers=W)
+    before = files(lake, "bags")
+    r = client.post("/api/bags/bag1/finish", json={"finished_on": TODAY}, headers=W)
+    assert r.json() == {"bag_id": "bag1", "written": True}
+    after = files(lake, "bags")
+    assert len(after) == len(before) + 1 and set(before) <= set(
+        after
+    )  # appended; the old record is still there
+    # A resend from the outbox, even with another date, writes nothing and keeps the first date.
+    again = client.post("/api/bags/bag1/finish", json={"finished_on": LATER}, headers=W)
+    assert again.json()["written"] is False and len(files(lake, "bags")) == len(after)
+    # Latest wins across a restart; the bag and its shots are all still there.
+    store = create_app(lake, HeaderAuth()).state.store
+    bag = store.bag("owner", "bag1")
+    assert bag.finished_on.isoformat() == TODAY and bag.coffee_freetext == "Onyx Geometry"
+    assert str(bag.roast_date) == "2026-10-18" and bag.opened_on is not None  # the rest of the bag is kept
+    assert [s.shot_id for s in store.shots_of("owner")] == ["s1"] and store.current_bag("owner") is None
+
+
+def test_a_finished_bag_leaves_today_and_the_pickers_and_stays_in_coffees(client):
+    client.post("/api/bags", json={"bag_id": "bag2", "coffee_freetext": "Other coffee"}, headers=W)
+    client.post("/api/shots", json=shot(1), headers=W)
+    client.get("/bag/bag1/use")  # selected on this phone, then finished
+    assert "Onyx Geometry" in client.get("/").text and "Switch coffee" in client.get("/").text
+    assert 'data-finish="bag1"' in client.get("/coffee/bag1").text
+
+    assert client.post("/api/bags/bag1/finish", json={"finished_on": TODAY}, headers=W).status_code == 200
+
+    today = client.get("/").text
+    assert "Other coffee" in today and "Onyx Geometry" not in today
+    assert "Switch coffee" not in today  # one open bag left: nothing to switch to
+    picker = client.get("/bags/switch").text
+    assert "Other coffee" in picker and "Onyx Geometry" not in picker
+    assert client.get("/bag/bag1/use").status_code == 404
+    assert prefill(client)["bag_id"] == "bag2"  # Log shot moves to an open bag despite the cookie
+    coffees = client.get("/coffees").text
+    assert "Onyx Geometry" in coffees and "· finished" in coffees
+    page = client.get("/coffee/bag1").text
+    assert f"inished {date.today():%b} {date.today().day}<" in page
+    assert "data-finish" not in page and "/shot/s1" in page  # no second Finish; its shots still listed
+
+
+def test_correcting_a_shot_of_a_finished_bag_still_offers_that_bag(client):
+    client.post("/api/bags", json={"bag_id": "bag2", "coffee_freetext": "Other coffee"}, headers=W)
+    client.post("/api/shots", json=shot(1), headers=W)
+    client.post("/api/bags/bag1/finish", json={}, headers=W)
+    log = client.get("/log?correct=s1").text
+    assert 'href="/log?correct=s1&amp;bag=bag1"' in log and 'href="/log?correct=s1&amp;bag=bag2"' in log
+
+
+def test_finishing_the_only_bag_leaves_today_on_the_last_coffee(client):
+    client.post("/api/shots", json=shot(1), headers=W)
+    client.post("/api/bags/bag1/finish", json={}, headers=W)  # no date: today
+    today = client.get("/").text
+    assert "Last coffee" in today and "Edit bag" not in today and "Switch coffee" not in today
+    assert prefill(client)["bag_id"] is None
+
+
+def test_edit_bag_still_using_it_opens_a_finished_bag_again(client, lake):
+    client.post("/api/bags/bag1/finish", json={"finished_on": TODAY}, headers=W)
+    reopen = {
+        "bag_id": "bag1",
+        "coffee_freetext": "Onyx Geometry",
+        "roast_date": "2026-10-18",
+        "finished_on": None,
+    }
+    assert client.post("/api/bags", json=reopen, headers=W).status_code == 200
+    assert client.app.state.store.current_bag("owner").bag_id == "bag1"
+    assert 'data-finish="bag1"' in client.get("/coffee/bag1").text
+    # Finished again later: a new record with the new date.
+    assert client.post("/api/bags/bag1/finish", json={"finished_on": LATER}, headers=W).json()["written"]
+    assert client.app.state.store.bag("owner", "bag1").finished_on.isoformat() == LATER
+
+
+def test_finish_refuses_other_peoples_bags_bad_dates_and_unknown_bags(client, lake):
+    bob = W | {"x-test-user": "bob", "X-Expected-User": "bob"}
+    before = len(files(lake, "bags"))
+    assert client.post("/api/bags/bag1/finish", json={}, headers=bob).status_code == 404
+    assert client.post("/api/bags/nope/finish", json={}, headers=W).status_code == 404
+    future = (date.today() + timedelta(days=5)).isoformat()
+    assert client.post("/api/bags/bag1/finish", json={"finished_on": future}, headers=W).status_code == 422
+    assert client.post("/api/bags/bag1/finish", json={"finished_on": "soon"}, headers=W).status_code == 422
+    assert client.post("/api/bags/bag1/finish", json={}).status_code == 403  # not from the app's own page
+    assert len(files(lake, "bags")) == before
+    assert client.app.state.store.bag("owner", "bag1").finished_on is None
+
+
+def test_finish_is_never_dated_before_the_bag_was_opened(client):
+    """A phone clock days behind the server's doesn't make a bag finished before it was opened."""
+    opened = client.app.state.store.bag("owner", "bag1").opened_on
+    client.post("/api/bags/bag1/finish", json={"finished_on": "2020-01-01"}, headers=W)
+    assert client.app.state.store.bag("owner", "bag1").finished_on == opened
