+// A bag's Finish: a second tap, then a record with finished_on (never a delete), queued like any write. It's
+// taken back on Edit bag ("Still using it"). The day is the phone's, so one finished offline keeps its day.
+function finishBag(b) {
+  const id = b.dataset.finish;
+  const box = b.closest("[data-finish-box]");
+  const label = b.textContent;
+  b.addEventListener("blur", () => { b.textContent = label; });
+  b.addEventListener("click", async () => {
+    if (b.textContent === label) {
+      b.textContent = "Tap again to finish it";
+      tick();
+      return;
+    }
+    b.disabled = true;
+    const now = new Date();
+    const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;
+    try {
+      await send(`finish:${id}`, `/api/bags/${id}/finish`, { finished_on: today });
+      await clearBagPages().catch(() => {});
+      tick(8);
+      go(location.pathname, `Bag finished: ${b.dataset.name}`);
+    } catch (err) {
+      if (err instanceof Rejected) {
+        hint(box, err.message);
+        b.disabled = false;
+        b.textContent = label;
+        return;
+      }
+      // No connection: the record waits in the outbox and goes through later.
+      b.hidden = true;
+      hint(box, "Finished on this phone. It syncs when you’re back online.");
+    }
+  });
+}
