+    def finish_bag(self, user_id: str, bag_id: str, on: date) -> bool:
+        """Finish: the stored bag again with finished_on set, as a new record (never a delete), like a retraction.
+        Finishing a finished bag writes nothing and keeps its date, so a resend from the outbox is harmless."""
+        prev = self._owned(self.bags, bag_id, user_id)
