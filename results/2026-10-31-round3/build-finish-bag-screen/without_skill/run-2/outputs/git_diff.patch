diff --git a/app/store.py b/app/store.py
index e7c62ba..cc57f18 100644
--- a/app/store.py
+++ b/app/store.py
@@ -416,6 +416,32 @@ class Store:
         self._commit(self.shots, shot_id, prev.item, "shots")
         return True
 
+    def finish_bag(self, user_id: str, bag_id: str, on: date) -> bool:
+        """Finish: the bag again with finished_on set, as a new record, never a delete. It leaves Today and the bag
+        pickers and stays in Coffees. Finishing a finished bag writes nothing (an outbox resend, a second phone)."""
+        prev = self._owned(self.bags, bag_id, user_id)
+        if prev is None or prev.deleted:
+            raise NotFound(bag_id)
+        if prev.item.finished_on:
+            return False
+        # The phone's date, with the same day's grace as a roast date, so no zone's "today" is refused.
+        if on > datetime.now(UTC).date() + timedelta(days=1):
+            raise Invalid("That finish date is in the future. Check the phone’s date.")
+        # Never before it was opened: opened_on is the server's date, which can be a day ahead of the phone's.
+        on = max(on, prev.item.opened_on or on)
+        self._commit(self.bags, bag_id, prev.item.model_copy(update={"finished_on": on}), "bags")
+        return True
+
+    def reopen_bag(self, user_id: str, bag_id: str) -> bool:
+        """Undo a finish: the bag again without finished_on, as a new record. Reopening an open bag writes nothing."""
+        prev = self._owned(self.bags, bag_id, user_id)
+        if prev is None or prev.deleted:
+            raise NotFound(bag_id)
+        if not prev.item.finished_on:
+            return False
+        self._commit(self.bags, bag_id, prev.item.model_copy(update={"finished_on": None}), "bags")
+        return True
+
