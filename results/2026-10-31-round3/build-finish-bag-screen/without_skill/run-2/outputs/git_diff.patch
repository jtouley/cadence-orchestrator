+// A bag's Finish: like Retract, no confirmation. A finish record (never a delete) is queued like any write, and an
+// undo strip stays for 5 s; then the bag's page opens again, showing it finished.
+function finishBag(b) {
+  const id = b.dataset.finishBag;
+  const key = `finish:${id}`;
+  const actions = document.querySelector("[data-actions]");
+  const strip = document.querySelector("[data-reopen]");
+  let timer = null;
+  let gone = "Bag finished";
+  const leave = () => { timer = setTimeout(() => go(location.pathname, gone), 5000); };
+  strip.addEventListener("focusin", () => clearTimeout(timer)); // focus on Undo holds it open
+  strip.addEventListener("focusout", leave);
+  b.addEventListener("click", async () => {
+    b.disabled = true;
+    const now = new Date();
+    const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;
+    try {
+      await send(key, `/api/bags/${id}/finish`, { finished_on: today });
+    } catch (err) {
+      if (err instanceof Rejected) {
+        hint(document.querySelector("main"), err.message);
+        b.disabled = false;
+        return;
+      }
+      strip.firstChild.textContent = gone = "Finished on this phone. It syncs when you’re back online.";
+    }
+    tick(8);
+    actions.hidden = true;
+    strip.hidden = false;
+    leave();
+  });
+  strip.querySelector("button").addEventListener("click", async () => {
+    clearTimeout(timer);
+    await sending.get(key)?.catch(() => {}); // a send already under way finishes first; then it's undone
+    try {
+      // A finish still on the phone is simply dropped; one that went up is undone on the server.
+      if (await store("readonly", (s) => s.get(key))) await store("readwrite", (s) => s.delete(key));
+      else await send(`reopen:${id}`, `/api/bags/${id}/reopen`, {});
+      go(location.pathname, "Bag back in use");
+    } catch (err) {
+      strip.firstChild.textContent = why(err);
+    }
+  });
+}
+
