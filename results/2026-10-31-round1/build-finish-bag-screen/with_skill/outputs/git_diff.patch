+def test_finish_bag_writes_one_record_and_drops_it_from_today_and_the_pickers(client, lake):
+    """Finish bag on the coffee page: a new bag record with finished_on, like a retraction; nothing deleted."""
+    client.post("/api/bags", json={"bag_id": "bag2", "coffee_freetext": "Other coffee"}, headers=W)
+    client.post("/api/shots", json=shot(1), headers=W)
+    client.post("/api/shots", json=shot(2, bag_id="bag2", coffee_freetext="Other coffee"), headers=W)
+    client.get("/bag/bag1/use")  # bag1 is on the grinder
+    page = client.get("/coffee/bag1").text
+    assert 'data-finish="bag1"' in page and ">Finish bag</button>" in page
+    assert "Onyx Geometry" in client.get("/").text and "Onyx Geometry" in client.get("/bags/switch").text
+    before = {p.name for p in files(lake, "bags")}
+
+    r = client.post("/api/bags/bag1/finish", json={"bag_id": "bag1", "finished_on": "2026-10-30"}, headers=W)
+    assert r.status_code == 200 and r.json() == {"bag_id": "bag1", "written": True}
+    after = {p.name for p in files(lake, "bags")}
+    assert before < after and len(after - before) == 1  # one record added, every earlier one still there
+    bag = client.app.state.store.bag("owner", "bag1")
+    assert str(bag.finished_on) == "2026-10-30"
+    assert (bag.coffee_freetext, str(bag.roast_date)) == (
+        "Onyx Geometry",
+        "2026-10-18",
+    )  # nothing else changed
+
+    # Finishing again (the outbox resending, a second tap, another tab, a later day) writes nothing more.
+    for day in ("2026-10-30", "2026-10-31"):
+        r = client.post("/api/bags/bag1/finish", json={"bag_id": "bag1", "finished_on": day}, headers=W)
+        assert r.json()["written"] is False
+    assert {p.name for p in files(lake, "bags")} == after
+    assert str(client.app.state.store.bag("owner", "bag1").finished_on) == "2026-10-30"
+    assert len(files(lake, "shots")) == 2 and {s.shot_id for s in shots.load_shots(lake)} == {"s1", "s2"}
