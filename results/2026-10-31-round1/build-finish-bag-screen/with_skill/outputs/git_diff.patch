+def test_finish_bag_defaults_to_today_in_the_phones_zone(client, lake):
+    from datetime import date
+    from zoneinfo import ZoneInfo
+
+    client.cookies.set("tz", "Pacific%2FKiritimati")  # UTC+14: often a day ahead of UTC
+    assert client.post("/api/bags/bag1/finish", headers=W).json()["written"] is True
+    want = datetime.now(ZoneInfo("Pacific/Kiritimati")).date()
+    assert client.app.state.store.bag("owner", "bag1").finished_on == want
+    # A date the phone can't have today, or not a date, is refused, and nothing is written.
+    client.post("/api/bags", json={"bag_id": "bag2", "coffee_freetext": "x"}, headers=W)
+    n = len(files(lake, "bags"))
+    far = (date.today() + timedelta(days=3)).isoformat()
+    assert client.post("/api/bags/bag2/finish", json={"finished_on": far}, headers=W).status_code == 422
+    assert client.post("/api/bags/bag2/finish", json={"finished_on": "soon"}, headers=W).status_code == 422
+    assert len(files(lake, "bags")) == n and client.app.state.store.bag("owner", "bag2").finished_on is None
+
+
+def test_only_the_owner_of_a_bag_can_finish_it(client, lake):
+    bob = W | {"x-test-user": "bob", "X-Expected-User": "bob"}
+    n = len(files(lake, "bags"))
+    assert (
+        client.post("/api/bags/bag1/finish", json={"finished_on": "2026-10-30"}, headers=bob).status_code
+        == 404
+    )
+    assert (
+        client.post("/api/bags/nope/finish", json={"finished_on": "2026-10-30"}, headers=W).status_code == 404
+    )
+    # Like every queued write: the header, and the account that made it.
+    assert client.post("/api/bags/bag1/finish", json={"finished_on": "2026-10-30"}).status_code == 403
+    other = {"X-Requested-With": "test", "X-Expected-User": "bob"}
+    assert (
+        client.post("/api/bags/bag1/finish", json={"finished_on": "2026-10-30"}, headers=other).status_code
+        == 403
+    )
+    assert len(files(lake, "bags")) == n and client.app.state.store.bag("owner", "bag1").finished_on is None
+    assert client.get("/coffee/bag1", headers={"x-test-user": "bob"}).status_code == 404
