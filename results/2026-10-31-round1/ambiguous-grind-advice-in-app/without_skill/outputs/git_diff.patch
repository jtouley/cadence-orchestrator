-
-def check_segment(seg: list[str]) -> None:
-    cmd, args = seg[0], seg[1:]
-    if "=" in cmd:
-        raise Unsafe("environment assignment")
-    if cmd == "git":
-        return check_git(args)
-    if cmd in PLAIN_READERS:
